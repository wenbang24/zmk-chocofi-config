#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

#include <behaviors.dtsi>

#include "zmk-helpers/helper.h"
#include "keys/36.h"

// global
#define QUICK_TAP_MS 150
#define TAPPING_TERM_MS 200
#define PRIOR_IDLE_MS 150

// layers
#define BASE 0
#define NUM 1
#define SYM 2
#define FN 3
#define WIN 4
#define GM 5

// redefined keycodes
#define _LWIN_    &kp LEFT_WIN
#define _RALT_    &kp RIGHT_ALT
#define _SPC_     &kp SPACE
#define _RET_     &kp RETURN

#define ___      &trans
#define _x_      &none

/* modtap */
ZMK_BEHAVIOR(md, hold_tap,
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
    bindings = <&kp>, <&kp>;
)

/ {
  chosen {
    zmk,matrix_transform = &five_column_transform;
  };
  macros {
        bt_clr_macro: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };
  behaviors {
        btclr_hold: btclr_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            quick-tap-ms = <0>;
            bindings = <&bt_clr_macro>, <&none>;
        };
    };
  combos {
    compatible = "zmk,combos";
    combo_lc {
      timeout-ms = <50>;
      key-positions = <10 11>;
      bindings = <&sk LCTRL>;
      layers = <0>;
    };
    combo_la {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&sk LALT>;
      layers = <0>;
    };
    combo_lg {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&sk LGUI>;
      layers = <0>;
    };
    combo_ls {
      timeout-ms = <50>;
      key-positions = <13 14>;
      bindings = <&sk LSHIFT>;
      layers = <0>;
    };
    combo_rc {
      timeout-ms = <50>;
      key-positions = <19 18>;
      bindings = <&sk RCTRL>;
      layers = <0>;
    };
    combo_ra {
      timeout-ms = <50>;
      key-positions = <18 17>;
      bindings = <&sk RALT>;
      layers = <0>;
    };
    combo_rg {
      timeout-ms = <50>;
      key-positions = <17 16>;
      bindings = <&sk RGUI>;
      layers = <0>;
    };
    combo_rs {
      timeout-ms = <50>;
      key-positions = <16 15>;
      bindings = <&sk RSHIFT>;
      layers = <0>;
    };
    combo_lca {
      timeout-ms = <50>;
      key-positions = <10 11 12>;
      bindings = <&sk LC(LALT)>;
      layers = <0>;
    };
    combo_lag {
      timeout-ms = <50>;
      key-positions = <11 12 13>;
      bindings = <&sk LA(LGUI)>;
      layers = <0>;
    };
    combo_lgs {
      timeout-ms = <50>;
      key-positions = <12 13 14>;
      bindings = <&sk LG(LSHIFT)>;
      layers = <0>;
    };
    combo_lcag {
      timeout-ms = <50>;
      key-positions = <10 11 12 13>;
      bindings = <&sk LC(LA(LGUI))>;
      layers = <0>;
    };
    combo_lags {
      timeout-ms = <50>;
      key-positions = <11 12 13 14>;
      bindings = <&sk LA(LG(LSHIFT))>;
      layers = <0>;
    };
    combo_lcags {
      timeout-ms = <50>;
      key-positions = <10 11 12 13 14>;
      bindings = <&sk LC(LA(LG(LSHIFT)))>;
      layers = <0>;
    };
    combo_rca {
      timeout-ms = <50>;
      key-positions = <19 18 17>;
      bindings = <&sk RC(RALT)>;
      layers = <0>;
    };
    combo_rag {
      timeout-ms = <50>;
      key-positions = <18 17 16>;
      bindings = <&sk RA(RGUI)>;
      layers = <0>;
    };
    combo_rgs {
      timeout-ms = <50>;
      key-positions = <17 16 15>;
      bindings = <&sk RG(RSHIFT)>;
      layers = <0>;
    };
    combo_rcag {
      timeout-ms = <50>;
      key-positions = <19 18 17 16>;
      bindings = <&sk RC(RA(RGUI))>;
      layers = <0>;
    };
    combo_rags {
      timeout-ms = <50>;
      key-positions = <18 17 16 15>;
      bindings = <&sk RA(RG(RSHIFT))>;
      layers = <0>;
    };
    combo_rcags {
      timeout-ms = <50>;
      key-positions = <19 18 17 16 15>;
      bindings = <&sk RC(RA(RG(RSHIFT)))>;
      layers = <0>;
    };
  };
};

/ {
  keymap {
    compatible = "zmk,keymap";
    base_layer {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭──────────────────────────────────────────────────────────╮
        // │     Q     │     W     │     E     │    R      │     T     │  │     Y     │     U    │     I     │     O     │     P     │
              &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U      &kp I       &kp O       &kp P
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼──────────┼───────────┼───────────┼───────────┤
        // │     A     │     S     │     D     │     F     │     G     │  │     H     │     J    │     K     │     L     │     ;     │
              &kp A       &kp S       &kp D       &kp F       &kp G           &kp H       &kp J      &kp K       &kp L      &kp SEMI
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼──────────┼───────────┼───────────┼───────────┤
        // │     Z     │     X     │     C     │     V     │     B     │  │     N     │     M    │     ,     │     .     │     '     │
              &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M    &kp COMMA     &kp DOT    &kp SQT
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼──────────┼───────────┼───────────┼───────────╯
                                    &lt FN ESC &lt SYM TAB &md LGUI RETURN  &kp LSHIFT &lt NUM SPACE &kp BSPC
        //                         │                                   │  │                                  │
        //                         ╰───────────────────────────────────╯  ╰──────────────────────────────────╯
      >;
    };
    number_layer {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭───────────────────────────────────────────────────────────╮
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
              &kp GRAVE    &kp N1      &kp N2      &kp N3    &kp MINUS         _x_       &kp LBKT    &kp RBKT    &kp FSLH    &kp BSLH
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_        &kp N4      &kp N5      &kp N6    &kp EQUAL         _x_      &kp RSHIFT  &kp RGUI    &kp RALT    &kp RCTRL
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_        &kp N7      &kp N8      &kp N9      &kp N0          _x_         _x_         _x_         _x_         _x_
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                     &kp LCTRL    &kp LALT    &kp LGUI      &kp LSHIFT     ___      &tog NUM
        //                         │                                   │  │                                   │
        //                         ╰───────────────────────────────────╯  ╰───────────────────────────────────╯
      >;
    };
    symbol_layer {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭───────────────────────────────────────────────────────────╮
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
              &kp TILDE   &kp EXCL    &kp AT      &kp HASH   &kp UNDER         _x_       &kp LBRC    &kp RBRC    &kp QMARK   &kp PIPE
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_       &kp DLLR    &kp PRCNT   &kp CARET   &kp PLUS         _x_      &kp RSHIFT  &kp RGUI    &kp RALT    &kp RCTRL
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_       &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR         _x_         _x_         _x_         _x_         _x_
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                     &kp LCTRL      ___       &kp LGUI      &kp LSHIFT     ___         ___
        //                         │                                   │  │                                   │
        //                         ╰───────────────────────────────────╯  ╰───────────────────────────────────╯
      >;
    };
    fn {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭───────────────────────────────────────────────────────────╮
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
              &kp F1      &kp F2      &kp F3      &kp F4        _x_       &kp C_VOL_DN &kp C_VOL_UP    _x_         _x_         _x_
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
              &kp F5      &kp F6      &kp F7      &kp F8        _x_          &kp LEFT    &kp DOWN    &kp UP     &kp RIGHT      _x_
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
              &kp F9      &kp F10     &kp F11     &kp F12       _x_        &kp C_PREV   &kp C_PP   &kp C_NEXT      _x_       &tog GM
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                        ___       &kp LALT    &kp LGUI      &kp LSHIFT  &kp LCTRL      ___
        //                         │                                   │  │                                   │
        //                         ╰───────────────────────────────────╯  ╰───────────────────────────────────╯
      >;
    };
    win {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭───────────────────────────────────────────────────────────╮
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
          &kp LA(SLASH) &kp LA(N1)  &kp LA(N2)  &kp LA(N3) &kp LA(MINUS) &kp LA(LS(LEFT)) &kp LA(LS(DOWN)) &kp LA(LS(UP)) &kp LA(LS(RIGHT))  _x_
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_      &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &kp LA(EQUAL) &kp LA(LEFT) &kp LA(DOWN) &kp LA(UP) &kp LA(RIGHT)  _x_
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
                _x_      &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &kp LA(N0)    &kp LA(LS(LC(LG(LEFT)))) &kp LA(LS(LC(LG(DOWN)))) &kp LA(LS(LC(LG(UP)))) &kp LA(LS(LC(LG(RIGHT))))  _x_
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                        _x_         _x_         _x_     &kp LS(LC(LGUI)) &kp LA(LS(TAB)) _x_
        //                         │                                   │  │                                   │
        //                         ╰───────────────────────────────────╯  ╰───────────────────────────────────╯
      >;
    };
    game_layer {
      bindings = <
        // ╭───────────────────────────────────────────────────────────╮  ╭───────────────────────────────────────────────────────────╮
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
               &kp N1      &kp N2      &kp N3      &kp N4      &kp N5         &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
               &kp N6      &kp N7      &kp W       &kp N8      &kp N9         &kp Q        _x_         _x_         _x_         _x_
        // ├───────────┼───────────┼───────────┼───────────┼───────────┤  ├───────────┼───────────┼───────────┼───────────┼───────────┤
        // │     _     │     _     │     _     │     _     │     _     │  │     _     │     _     │     _     │     _     │     _     │
            &kp LSHIFT     &kp A       &kp S       &kp D       &kp F           _x_         _x_         _x_   &btclr_hold 0 0  &tog GM
        // ╰───────────┼───────────┼───────────┼───────────┼───────────╯  ╰───────────┼───────────┼───────────┼───────────┼───────────╯
                                      &kp ESC    &kp SPACE     &kp E         &kp TAB       ___         ___
        //                         │                                   │  │                                   │
        //                         ╰───────────────────────────────────╯  ╰───────────────────────────────────╯
      >;
    };
  };
};
